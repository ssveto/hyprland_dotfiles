# Noctalia shell (owns the bar, notifications, launcher, lock/idle, clipboard, wallpaper)
exec noctalia --daemon

# Auth: Noctalia runs its own polkit agent (see ~/.config/noctalia/config.toml)
# exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Import environment variables for user systemd service manager
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP

# Update dbus environments with display variables
exec hash dbus-update-activation-environment 2>/dev/null && \
     dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP

# Idle configuration: Noctalia owns idle/lock. Keep one swayidle hook so the
# session locks before hardware suspend (lid / power button).
# exec swayidle idlehint 1
exec swayidle -w before-sleep "noctalia msg session lock"

# Desktop notifications: handled by Noctalia
# exec mako

# Start foot server (only if not already running, so reloads don't warn)
exec_always --no-startup-id sh -c 'pgrep -x foot >/dev/null 2>&1 || foot --server'

# Autotiling
exec autotiling

# Clipboard: handled by Noctalia
# exec wl-paste --type text --watch cliphist store
# exec wl-paste --type image --watch cliphist store
     
# Network Applet
exec nm-applet --indicator

# Firewall Applet
exec sleep 2 && firewall-applet

# Welcome App (EndeavourOS only; set is_endeavouros = false on other distros)
{{- if .is_endeavouros }}
exec eos-welcome --startdelay=3
{{- end }}

# Sway Fader
# exec python3 ~/.config/sway/scripts/swayfader.py

# Launcher: handled by Noctalia
# exec_always nwg-drawer -r -c 7 -is 90 -mb 10 -ml 50 -mr 50 -mt 10
