# Per-machine chezmoi configuration template.
# `chezmoi init` renders this into ~/.config/chezmoi/chezmoi.toml.
# Edit the values below for each machine, then run:
#   chezmoi init && chezmoi apply
#
# On a new PC, if the monitor name differs, copy it from:
#   hyprctl monitors
# and update `output` below.

[data]
    # Primary monitor output name. Used by the Noctalia lockscreen widget
    # and the per-monitor wallpaper entry in settings.toml.
    output = "DP-3"
